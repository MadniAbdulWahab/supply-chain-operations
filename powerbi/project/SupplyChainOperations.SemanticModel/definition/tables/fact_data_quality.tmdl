table fact_data_quality

	/// evaluation run id
	column evaluation_run_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: evaluation_run_id

	/// evaluated at
	column evaluated_at
		dataType: dateTime
		formatString: yyyy-mm-dd HH:mm
		summarizeBy: none
		sourceColumn: evaluated_at

	/// rule code
	column rule_code
		dataType: string
		summarizeBy: none
		sourceColumn: rule_code

	/// record type
	column record_type
		dataType: string
		summarizeBy: none
		sourceColumn: record_type

	/// failed record count
	column failed_record_count
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: failed_record_count

	/// affected file count
	column affected_file_count
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: affected_file_count

	partition fact_data_quality = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(#"pDataRoot" & "\fact_data_quality.parquet"))
			in
				Source
