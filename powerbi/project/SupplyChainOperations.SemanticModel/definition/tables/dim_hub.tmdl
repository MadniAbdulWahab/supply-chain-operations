table dim_hub

	/// hub key
	column hub_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: hub_key

	/// hub id
	column hub_id
		dataType: string
		summarizeBy: none
		sourceColumn: hub_id

	/// hub name
	column hub_name
		dataType: string
		summarizeBy: none
		sourceColumn: hub_name

	/// city
	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	/// state code
	column state_code
		dataType: string
		summarizeBy: none
		sourceColumn: state_code

	partition dim_hub = m
		mode: import
		source =
			let
				Source = if #"pDataRoot" = "__DATA_ROOT__" then #table(type table [hub_key = Int64.Type, hub_id = type text, hub_name = type text, city = type text, state_code = type text], {}) else Parquet.Document(File.Contents(#"pDataRoot" & "\dim_hub.parquet"))
			in
				Source
