table fact_shipments

	/// shipment id
	column shipment_id
		dataType: string
		summarizeBy: none
		sourceColumn: shipment_id

	/// created date key
	column created_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: created_date_key

	/// promised date key
	column promised_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: promised_date_key

	/// delivered date key
	column delivered_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: delivered_date_key

	/// origin hub key
	column origin_hub_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: origin_hub_key

	/// destination hub key
	column destination_hub_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: destination_hub_key

	/// route key
	column route_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: route_key

	/// service level key
	column service_level_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: service_level_key

	/// customer region
	column customer_region
		dataType: string
		summarizeBy: none
		sourceColumn: customer_region

	/// weight kg
	column weight_kg
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: weight_kg

	/// created ts
	column created_ts
		dataType: dateTime
		formatString: yyyy-mm-dd HH:mm
		summarizeBy: none
		sourceColumn: created_ts

	/// promised delivery ts
	column promised_delivery_ts
		dataType: dateTime
		formatString: yyyy-mm-dd HH:mm
		summarizeBy: none
		sourceColumn: promised_delivery_ts

	/// actual delivery ts
	column actual_delivery_ts
		dataType: dateTime
		formatString: yyyy-mm-dd HH:mm
		summarizeBy: none
		sourceColumn: actual_delivery_ts

	/// transit hours
	column transit_hours
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: transit_hours

	/// delay minutes
	column delay_minutes
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: delay_minutes

	/// is on time
	column is_on_time
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_on_time

	/// current status
	column current_status
		dataType: string
		summarizeBy: none
		sourceColumn: current_status

	/// valid event count
	column valid_event_count
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: valid_event_count

	/// late arriving event count
	column late_arriving_event_count
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: late_arriving_event_count

	partition fact_shipments = m
		mode: import
		source =
			let
				Source = if #"pDataRoot" = "__DATA_ROOT__" then #table(type table [shipment_id = type text, created_date_key = Int64.Type, promised_date_key = Int64.Type, delivered_date_key = Int64.Type, origin_hub_key = Int64.Type, destination_hub_key = Int64.Type, route_key = Int64.Type, service_level_key = Int64.Type, customer_region = type text, weight_kg = type number, created_ts = type datetime, promised_delivery_ts = type datetime, actual_delivery_ts = type datetime, transit_hours = type number, delay_minutes = Int64.Type, is_on_time = type logical, current_status = type text, valid_event_count = Int64.Type, late_arriving_event_count = Int64.Type], {}) else Parquet.Document(File.Contents(#"pDataRoot" & "\fact_shipments.parquet"))
			in
				Source
